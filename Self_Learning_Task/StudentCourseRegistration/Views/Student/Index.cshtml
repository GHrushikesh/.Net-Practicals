@model IEnumerable<StudentCourseRegistration.Models.Student>

@{
    ViewData["Title"] = "Student Directory";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2">
    <div>
        <h2 class="h4 fw-semibold text-dark mb-1">Student Directory</h2>
        <p class="text-muted small mb-0">Enrolled students across programs and active terms.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn-apple-primary">
            + Register Student
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="apple-card p-3 mb-4 d-flex justify-content-between align-items-center" style="background-color: #f2f9f4; border-color: #bce4c7;">
        <span class="small" style="color: #1e7e34; font-weight: 500;">
            @TempData["SuccessMessage"]
        </span>
        <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="apple-card p-3">
            <div class="text-uppercase small text-muted fw-semibold" style="font-size: 11px;">Total Students</div>
            <div class="fs-4 fw-semibold text-dark mt-1">@Model.Count()</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="apple-card p-3">
            <div class="text-uppercase small text-muted fw-semibold" style="font-size: 11px;">Programs</div>
            <div class="fs-4 fw-semibold text-dark mt-1">@Model.Select(s => s.Course).Distinct().Count()</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="apple-card p-3">
            <div class="text-uppercase small text-muted fw-semibold" style="font-size: 11px;">Semesters</div>
            <div class="fs-4 fw-semibold text-dark mt-1">@Model.Select(s => s.Semester).Distinct().Count()</div>
        </div>
    </div>
</div>

<div class="apple-card overflow-hidden">
    <div class="table-responsive">
        <table class="apple-table">
            <thead>
                <tr>
                    <th style="width: 70px;">ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Course</th>
                    <th>Semester</th>
                    <th class="text-end" style="width: 130px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted small">
                            No student records found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var student in Model)
                    {
                        <tr>
                            <td class="text-muted">#@student.Id</td>
                            <td class="fw-medium text-dark">@student.Name</td>
                            <td>
                                <a href="mailto:@student.Email" class="text-decoration-none text-muted">@student.Email</a>
                            </td>
                            <td>
                                <span class="apple-pill">@student.Course</span>
                            </td>
                            <td>
                                <span class="apple-pill apple-pill-blue">Term @student.Semester</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@student.Id" class="btn-apple-link">
                                    Details &rsaquo;
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
