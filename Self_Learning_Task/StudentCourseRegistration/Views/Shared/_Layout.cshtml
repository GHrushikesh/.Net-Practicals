<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Course Registration</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="apple-nav">
        <div class="container d-flex justify-content-between align-items-center">
            <a class="apple-brand" asp-controller="Home" asp-action="Index">Course Registration</a>
            <nav class="d-flex align-items-center">
                <a class="apple-nav-link" asp-controller="Home" asp-action="Index">Overview</a>
                <a class="apple-nav-link" asp-controller="Student" asp-action="Index">Students</a>
                <a class="apple-nav-link" asp-controller="Student" asp-action="Create">Register</a>
            </nav>
            <div class="d-none d-md-block text-end">
                <span class="apple-pill">Marwadi University</span>
            </div>
        </div>
    </header>

    <div class="container flex-grow-1 py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="apple-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center text-center text-md-start">
            <div>
                Department of Computer Engineering &middot; Marwadi University
            </div>
            <div class="mt-2 mt-md-0">
                .NET Technologies (01CE1523) &middot; ASP.NET Core MVC
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
